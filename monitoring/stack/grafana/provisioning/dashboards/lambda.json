{
  "uid": "theone-lambda",
  "title": "Lambda",
  "tags": [
    "theone",
    "lambda"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "실패 (Errors)",
      "description": "0 이 아니면 그 함수가 실패했습니다. Airflow 가 부른 것이면 태스크 알림도 함께 옵니다.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "theone-cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "theone-cloudwatch"
          },
          "namespace": "AWS/Lambda",
          "metricName": "Errors",
          "statistic": "Sum",
          "dimensions": {
            "FunctionName": "*"
          },
          "matchExact": true,
          "region": "default",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "period": "300"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
