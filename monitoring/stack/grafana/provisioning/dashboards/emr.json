          "dimensions": {
            "ApplicationId": "${EMR_APPLICATION_ID}",
            "ApplicationName": "*"
          },
          "matchExact": true,
          "region": "default",
          "label": "Failed",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "period": "60"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "cloudwatch",
            "uid": "theone-cloudwatch"
          },
          "namespace": "AWS/EMRServerless",
          "metricName": "SuccessJobs",
          "statistic": "Sum",
          "dimensions": {
            "ApplicationId": "${EMR_APPLICATION_ID}",
            "ApplicationName": "*"
          },
          "matchExact": true,
          "region": "default",
          "label": "Success",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "period": "60"
        }
      ],
      "pluginVersion": "11.5.0",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
