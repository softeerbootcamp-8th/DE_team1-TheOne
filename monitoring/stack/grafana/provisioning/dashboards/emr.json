    {
      "id": 1,
      "type": "stat",
      "title": "진행 중",
      "description": "지금 돌고 있는 작업과 대기 중인 작업. 순간 상태라 마지막 값을 봅니다.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "theone-cloudwatch"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "theone-cloudwatch"
          },
          "namespace": "AWS/EMRServerless",
          "metricName": "RunningJobs",
          "statistic": "Sum",
          "dimensions": {
            "ApplicationId": "${EMR_APPLICATION_ID}",
            "ApplicationName": "*"
          },
          "matchExact": true,
          "region": "default",
          "label": "Running",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "period": "60"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "theone-cloudwatch"
          },
          "namespace": "AWS/EMRServerless",
          "metricName": "PendingJobs",
