          "metricEditorMode": 0,
          "period": "60"
        }
      ],
      "pluginVersion": "11.5.0",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
