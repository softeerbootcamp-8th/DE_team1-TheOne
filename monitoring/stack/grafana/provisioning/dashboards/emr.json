        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "메모리 사용 (GB)",
      "description": "워커가 실제로 쓴 메모리와 애플리케이션 용량 상한. 상한선에 붙으면 자원이 모자란 것입니다.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "theone-cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "theone-cloudwatch"
          },
          "metricQueryType": 1,
          "metricEditorMode": 1,
          "sqlExpression": "SELECT SUM(WorkerMemoryUsed) FROM \"AWS/EMRServerless\" WHERE ApplicationId = '${EMR_APPLICATION_ID}' GROUP BY WorkerType",
          "namespace": "AWS/EMRServerless",
          "metricName": "WorkerMemoryUsed",
          "statistic": "Sum",
          "dimensions": {},
          "region": "default",
          "period": "60"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "theone-cloudwatch"
          },
          "namespace": "AWS/EMRServerless",
          "metricName": "MaxMemoryAllowed",
          "statistic": "Maximum",
          "dimensions": {
            "ApplicationId": "${EMR_APPLICATION_ID}",
            "ApplicationName": "*"
          },
          "matchExact": true,
          "region": "default",
          "label": "용량 상한",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "period": "60"
        }
      ],
      "pluginVersion": "11.5.0",
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
