{
  "uid": "theone-emr",
  "title": "EMR Serverless",
  "tags": [
    "theone",
    "emr"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-12h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "작업 상태",
      "description": "지금 도는 작업과 최근 결과. 실패가 0이 아니면 Slack 알림도 함께 옵니다.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "theone-cloudwatch"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "theone-cloudwatch"
          },
          "namespace": "AWS/EMRServerless",
          "metricName": "RunningJobs",
          "statistic": "Sum",
          "dimensions": {
            "ApplicationId": "${EMR_APPLICATION_ID}",
            "ApplicationName": "*"
          },
          "matchExact": true,
          "region": "default",
          "label": "Running",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "period": "60"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "theone-cloudwatch"
          },
          "namespace": "AWS/EMRServerless",
          "metricName": "PendingJobs",
          "statistic": "Sum",
          "dimensions": {
            "ApplicationId": "${EMR_APPLICATION_ID}",
            "ApplicationName": "*"
          },
          "matchExact": true,
          "region": "default",
          "label": "Pending",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "period": "60"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "theone-cloudwatch"
          },
          "namespace": "AWS/EMRServerless",
          "metricName": "FailedJobs",
