    {
      "id": 2,
      "type": "timeseries",
      "title": "메모리 사용 (GB)",
      "description": "워커가 실제로 쓴 메모리(Spark_Driver·Spark_Executor)와 애플리케이션 용량 상한. EMR 이 잡아둔 '할당' 은 뺐습니다 — 애플리케이션 단위라 워커 단위 사용량과 갱신 주기가 어긋나, 워커가 막 뜬 분에는 사용량이 130 MB 인데 할당이 0 GB 로 찍힙니다. 메모리에는 알림이 없습니다 — 용량 알림은 CPU 만 봅니다.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "theone-cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "theone-cloudwatch"
          },
          "metricQueryType": 1,
          "metricEditorMode": 1,
          "sqlExpression": "SELECT SUM(WorkerMemoryUsed) FROM \"AWS/EMRServerless\" WHERE ApplicationId = '${EMR_APPLICATION_ID}' GROUP BY WorkerType",
          "namespace": "AWS/EMRServerless",
          "metricName": "WorkerMemoryUsed",
          "statistic": "Sum",
          "dimensions": {},
          "region": "default",
          "period": "60"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "theone-cloudwatch"
          },
          "namespace": "AWS/EMRServerless",
          "metricName": "MaxMemoryAllowed",
          "statistic": "Maximum",
          "dimensions": {
            "ApplicationId": "${EMR_APPLICATION_ID}",
            "ApplicationName": "*"
          },
          "matchExact": true,
          "region": "default",
          "label": "용량 상한",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "period": "60"
        }
      ],
      "pluginVersion": "11.5.0",
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "links",
                "value": []
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
