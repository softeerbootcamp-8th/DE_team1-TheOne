{
  "start": "-PT12H",
  "periodOverride": "inherit",
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "# TheOne EMR Serverless\n**언제 얼마나 썼는지**를 실제 사용량으로 봅니다. 붉은 선이 애플리케이션 용량 상한이고, 거기에 붙으면 자원이 모자란 것입니다. EC2 호스트 자원은 Grafana 에서 봅니다."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 2,
      "width": 24,
      "height": 4,
      "properties": {
        "title": "EMR Serverless job states",
        "view": "singleValue",
        "region": "${AWS_REGION}",
        "period": 60,
        "stat": "Sum",
        "metrics": [
          [
            {
              "expression": "SUM(SEARCH('{AWS/EMRServerless,ApplicationId,ApplicationName} MetricName=\"RunningJobs\" ApplicationId=\"${EMR_APPLICATION_ID}\"', 'Sum'))",
              "label": "Running",
              "id": "running"
            }
          ],
          [
            {
              "expression": "SUM(SEARCH('{AWS/EMRServerless,ApplicationId,ApplicationName} MetricName=\"PendingJobs\" ApplicationId=\"${EMR_APPLICATION_ID}\"', 'Sum'))",
              "label": "Pending",
              "id": "pending"
            }
          ],
          [
            {
              "expression": "SUM(SEARCH('{AWS/EMRServerless,ApplicationId,ApplicationName} MetricName=\"FailedJobs\" ApplicationId=\"${EMR_APPLICATION_ID}\"', 'Sum'))",
              "label": "Failed",
              "id": "failed"
            }
          ],
          [
            {
              "expression": "SUM(SEARCH('{AWS/EMRServerless,ApplicationId,ApplicationName} MetricName=\"SuccessJobs\" ApplicationId=\"${EMR_APPLICATION_ID}\"', 'Sum'))",
              "label": "Success",
              "id": "success"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 7,
      "properties": {
        "title": "EMR memory used (GB)",
        "region": "${AWS_REGION}",
        "period": 60,
        "yAxis": {
          "left": {
            "min": 0,
            "label": "GB",
            "showUnits": false
          }
        },
        "metrics": [
          [
            {
              "expression": "SELECT SUM(WorkerMemoryUsed) FROM \"AWS/EMRServerless\" WHERE ApplicationId = '${EMR_APPLICATION_ID}' GROUP BY WorkerType",
              "id": "u"
            }
          ],
          [
            {
              "expression": "SUM(SEARCH('{AWS/EMRServerless,ApplicationId,ApplicationName} MetricName=\"MaxMemoryAllowed\" ApplicationId=\"${EMR_APPLICATION_ID}\"', 'Maximum'))",
              "label": "용량 상한 (GB)",
              "id": "cap",
              "color": "#d13212"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 7,
      "properties": {
        "title": "EMR CPU used (vCPU)",
        "region": "${AWS_REGION}",
        "period": 60,
        "yAxis": {
          "left": {
            "min": 0,
            "label": "vCPU",
            "showUnits": false
          }
        },
        "metrics": [
          [
            {
              "expression": "SELECT SUM(WorkerCpuUsed) FROM \"AWS/EMRServerless\" WHERE ApplicationId = '${EMR_APPLICATION_ID}' GROUP BY WorkerType",
              "id": "u"
            }
          ],
          [
            {
              "expression": "SUM(SEARCH('{AWS/EMRServerless,ApplicationId,ApplicationName} MetricName=\"MaxCPUAllowed\" ApplicationId=\"${EMR_APPLICATION_ID}\"', 'Maximum'))",
              "label": "용량 상한 (vCPU)",
              "id": "cap",
              "color": "#d13212"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 13,
      "width": 24,
      "height": 5,
      "properties": {
        "title": "EMR worker count",
        "region": "${AWS_REGION}",
        "period": 60,
        "yAxis": {
          "left": {
            "min": 0
          }
        },
        "metrics": [
          [
            {
              "expression": "SUM(SEARCH('{AWS/EMRServerless,ApplicationId,ApplicationName} MetricName=\"RunningWorkerCount\" ApplicationId=\"${EMR_APPLICATION_ID}\"', 'Maximum'))",
              "label": "Running",
              "id": "wrun"
            }
          ],
          [
            {
              "expression": "SUM(SEARCH('{AWS/EMRServerless,ApplicationId,ApplicationName} MetricName=\"PendingCreationWorkerCount\" ApplicationId=\"${EMR_APPLICATION_ID}\"', 'Maximum'))",
              "label": "Pending creation",
              "id": "wpend"
            }
          ]
        ]
      }
    }
  ]
}
