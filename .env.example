# 로컬 개발용. 복사해서 .env 로 저장하고 실제 값을 채우세요. .env는 커밋하지 않습니다.
# Lambda 런타임에서는 이 파일을 읽지 않고, 콘솔/IaC에 등록된 환경변수와 IAM 역할을 씁니다.

# S3Loader가 쓸 버킷 (lambda/functions/common/s3_loader.py). bronze/silver/gold가
# 이 버킷 하나를 공유하고 레이어는 key prefix(bronze/..., silver/..., gold/...)로만 구분함.
DATA_LAKE_S3_BUCKET=

# raw_to_bronze(monthly_taxi_trip·driver_vehicle_monthly_snapshot·lease_vehicle_inventory)의
# 적재 위치. local이면 BRONZE_DIR, s3면 DATA_LAKE_S3_BUCKET을 씀.
BRONZE_STORAGE=local

# boto3가 자동으로 읽는 표준 변수. 로컬에 aws configure 로 등록해뒀다면 비워둬도 됩니다.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ev_charging_stations_raw_to_bronze 가 쓰는 기존 시크릿
NLR_API_KEY=

# source_api(sub/source_api/server.py) 원천 서빙 설정.
# local이면 로컬 manifest 레이아웃, prod면 S3에서 고정 키로 읽음.
SOURCE_API_ENV=local
SOURCE_API_HOST=
SOURCE_API_PORT=
SOURCE_API_LOCAL_ROOT=
# prod일 때만 필요. 비워두면 local 모드에서는 안 씀.
SOURCE_API_S3_BUCKET=
SOURCE_API_S3_PREFIX=
# 응답을 흘려보낼 때 한 번에 읽는 바이트 수. 비워두면 1MiB.
SOURCE_API_CHUNK_SIZE=

GOLD_DATABASE_URL=
