# 로컬 개발용. 복사해서 .env 로 저장하고 실제 값을 채우세요. .env는 커밋하지 않습니다.
# Lambda 런타임에서는 이 파일을 읽지 않고, 콘솔/IaC에 등록된 환경변수와 IAM 역할을 씁니다.

# S3Loader가 쓸 버킷 (lambda/functions/common/s3_loader.py). bronze/silver/gold가
# 이 버킷 하나를 공유하고 레이어는 key prefix(bronze/..., silver/..., gold/...)로만 구분함.
DATA_LAKE_S3_BUCKET=

# boto3가 자동으로 읽는 표준 변수. 로컬에 aws configure 로 등록해뒀다면 비워둬도 됩니다.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ev_charging_stations_raw_to_bronze 가 쓰는 기존 시크릿
NLR_API_KEY=
